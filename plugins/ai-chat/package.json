{
  "name": "ai-chat",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "main": "./dist/preload.js",
  "publicPlugin": {
    "icon": "./assets/ai.png",
    "title": "AI助手",
    "subtitle": "AI助手",
    "preferences": [
      {
        "name": "baseURL",
        "title": "baseURL",
        "type": "text",
        "required": true
      },
      {
        "name": "apiKey",
        "title": "apiKey",
        "type": "text",
        "required": true
      },
      {
        "name": "model",
        "title": "model",
        "type": "text",
        "required": true
      }
    ],
    "commands": [
      {
        "name": "ai-chat",
        "title": "AI助手",
        "mode": "none",
        "entry": "http://localhost:4000/#/ai/chat",
        "matches": [
          {
            "type": "text",
            "keywords": [
              "AI",
              "ai",
              "ask",
              "chat"
            ]
          },
          {
            "type": "trigger",
            "triggers": [
              "ai",
              "ask"
            ],
            "title": "ask $query"
          }
        ]
      }
    ]
  },
  "dependencies": {
    "@public/api": "workspace:^",
    "crel": "^4.2.1",
    "sse.js": "^2.5.0"
  }
}
