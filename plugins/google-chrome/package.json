{
  "name": "google-chrome",
  "version": "1.0.0",
  "description": "",
  "main": "dist/preload.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "publicPlugin": {
    "icon": "./assets/chrome.png",
    "title": "Google Chrome",
    "subtitle": "Search open tabs, bookmarks and history in Google Chrome.",
    "commands": [
      {
        "name": "search-tab",
        "title": "Search Google Chrome Tabs",
        "subtitle": "List all tabs and go to the selected.",
        "mode": "listView",
        "matches": [
          {
            "type": "text",
            "keywords": [
              "google chrome tabs",
              "tabs",
              "chrome"
            ]
          }
        ],
        "preload": "dist/command.preload.js"
      },
      {
        "name": "search-chrome-history",
        "title": "Search Google Chrome History",
        "subtitle": "Search Google Chrome History",
        "mode": "listView",
        "preload": "dist/command.preload.js"
      },
      {
        "name": "create-window",
        "title": "打开新的窗口",
        "subtitle": "打开新的 Google Chrome 窗口",
        "mode": "none"
      }
    ]
  },
  "dependencies": {
    "@public/api": "workspace:^",
    "@public/shared": "workspace:^",
    "@public/utils": "workspace:*",
    "run-applescript": "^7.0.0"
  }
}
