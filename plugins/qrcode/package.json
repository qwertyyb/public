{
  "name": "qrcode",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "publicPlugin": {
    "title": "二维码",
    "subtitle": "生成、解析二维码",
    "icon": "https://img.icons8.com/pastel-glyph/64/4a90e2/qr-code--v1.png",
    "main": "./dist/index.js",
    "commands": [
      {
        "name": "generate",
        "title": "生成二维码",
        "subtitle": "生成二维码",
        "mode": "none",
        "matches": [
          {
            "type": "text",
            "keywords": [
              "qrcode",
              "生成二维码"
            ]
          },
          {
            "type": "trigger",
            "triggers": [
              "qr"
            ],
            "title": "生成二维码“$query”"
          }
        ]
      },
      {
        "name": "generate-for-current-url",
        "title": "分享当前页面",
        "subtitle": "生成当前页面的分享二维码",
        "mode": "none",
        "matches": [
          {
            "type": "text",
            "keywords": [
              "qrcu"
            ]
          }
        ]
      },
      {
        "name": "detect",
        "title": "解析二维码",
        "subtitle": "解析二维码",
        "mode": "listView",
        "preload": "./dist/preload.js",
        "matches": [
          {
            "type": "text",
            "keywords": [
              "detect qrcode",
              "解析二维码"
            ]
          }
        ]
      }
    ]
  },
  "dependencies": {
    "@public/osx-utils": "workspace:^",
    "@public/shared": "workspace:^"
  }
}
