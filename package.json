{
  "name": "public",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.14.0"
  },
  "build": {
    "appId": "cn.qwertyyb.public",
    "asar": true,
    "asarUnpack": [
      "dist/native_modules/**/*"
    ],
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "assets/**/*",
      "plugins/**/*",
      "packages/render/dist/**/*",
      "!plugins/*/src",
      "!plugins/**/*.ts",
      "!plugins/*/node_modules/**/*",
      "!webpack/**/*",
      "!test/**/*",
      "!data/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "build"
    },
    "afterSign": "scripts/notarize.js",
    "mac": {
      "asar": false,
      "category": "public.app-category.utilities",
      "type": "distribution",
      "identity": "Yongbang Yang (T68XK6867P)",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "electronLanguages": [
        "en",
        "zh_CN"
      ],
      "extendInfo": {
        "LSBackgroundOnly": 1,
        "LSUIElement": 1
      }
    }
  },
  "scripts": {
    "electron": "cross-env NODE_ENV=development electron dist/index.js --remote-debugging-port=8222",
    "start:render": "cd ./packages/render && npm run dev || 0",
    "dev": "tsx webpack/start.ts",
    "build:render": "pnpm --filter render build-only",
    "build": "tsx webpack/start.ts build",
    "pack": "electron-builder -c.mac.identity=null --dir",
    "release": "NODE_ENV=production && npm run build:render && npm run tsc && electron-builder --publish=always"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "overrides": {
      "leveldown": "6.1.1",
      "app-builder-lib": "next"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/node": "^24.0.4",
    "@types/webpack": "^5.28.5",
    "@types/webpack-env": "^1.18.5",
    "concurrently": "^6.0.0",
    "cross-env": "^7.0.3",
    "electron": "^35.0.1",
    "electron-builder": "^26.0.18",
    "electron-notarize": "^1.2.2",
    "node-loader": "^2.0.0",
    "nodemon": "^2.0.7",
    "string-replace-loader": "^3.2.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vue-loader": "^17.4.2",
    "wait-on": "^7.2.0",
    "webpack": "^5.92.1",
    "webpack-cli": "^6.0.1"
  }
}
