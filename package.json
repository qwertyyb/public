{
  "name": "public",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "build": {
    "appId": "cn.qwertyyb.public",
    "asar": false,
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!**/node_modules",
      "plugins/*/package.json",
      "plugins/*/dist/**/*",
      "plugins/*/lib/**/*",
      "plugins/*/public/**/*",
      "!plugins/src",
      "render/dist/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "build"
    },
    "afterSign": "scripts/notarize.js",
    "mac": {
      "asar": true,
      "category": "public.app-category.utilities",
      "type": "distribution",
      "identity": "Yongbang Yang (T68XK6867P)",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "electronLanguages": [
        "en",
        "zh_CN"
      ],
      "extendInfo": {
        "LSBackgroundOnly": 1,
        "LSUIElement": 1
      }
    }
  },
  "scripts": {
    "electron": "cross-env NODE_ENV=development electron dist/index.js --remote-debugging-port=8222",
    "start:electron": "nodemon --exec 'npm run electron || exit 1'",
    "start:render": "cd ./packages/render && npm run dev",
    "webpack:main": "webpack --config ./webpack/webpack.config.main.ts -w",
    "webpack:preload": "webpack --config ./webpack/webpack.config.preload.ts -w",
    "webpack:plugin": "webpack --config ./webpack/webpack.config.plugin.ts -w",
    "webpack:plugin:preload": "webpack --config ./webpack/webpack.config.plugin.preload.ts -w",
    "start": "concurrently --names \"main,preload,plugin,render,electron\" -c \"bgBlue.bold,bgBlack.bold,bgMagenta.bold,bgYellow.bold,bgGreen.bold\" \"npm run webpack:main\" \"npm run webpack:preload\" \"npm run webpack:plugin\" \"npm run start:render\" \"wait-on tcp:localhost:4000 && npm run start:electron\"",
    "build:main": "webpack --config ./webpack/webpack.config.main.ts --mode=production",
    "build:preload": "webpack --config ./webpack/webpack.config.preload.ts --mode=production",
    "build:plugin": "webpack --config ./webpack/webpack.config.plugin.ts --mode=production",
    "build:plugin:preload": "webpack --config ./webpack/webpack.config.plugin.preload.ts --mode=production",
    "build:render": "cd ./render && npm build",
    "build": "concurrently --names \"main,preload,plugin,render\" -c \"bgBlue.bold,bgGreen.bold,bgMagenta.bold,bgYellow.bold\" \"npm run build:main\" \"npm run build:preload\" \"npm run build:plugin\" \"npm run build:render\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "overrides": {
      "leveldown": "6.1.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "@types/webpack": "^5.28.5",
    "@types/webpack-env": "^1.18.5",
    "concurrently": "^6.0.0",
    "cross-env": "^7.0.3",
    "electron": "^35.0.1",
    "node-loader": "^2.0.0",
    "nodemon": "^2.0.7",
    "ts-node": "^10.9.2",
    "wait-on": "^7.2.0",
    "webpack": "^5.92.1"
  },
  "dependencies": {
    "string-replace-loader": "^3.2.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3"
  }
}
