{
  "name": "public",
  "version": "0.0.6",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/qwertyyb/public.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "rebuild:uiohook-napi": "electron-rebuild --build-from-source -f -m ./node_modules/uiohook-napi",
    "rebuild:leveldown": "electron-rebuild -f -w leveldown",
    "rebuild:others": "electron-rebuild -f -w ./node_modules/better-sqlite3",
    "postinstall": "npm run rebuild:uiohook-napi && npm run rebuild:leveldown && npm run rebuild:others"
  },
  "nodemonConfig": {
    "watch": [
      "dist/**/*"
    ]
  },
  "keywords": [],
  "author": "qwertyyb",
  "description": "public tools",
  "license": "ISC",
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@electron/remote": "^2.1.2",
    "@nut-tree-fork/nut-js": "^4.2.1",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^12.20.55",
    "@types/pouchdb": "^6.4.2",
    "electron-devtools-installer": "^3.1.1",
    "electron-updater": "^4.3.5",
    "pouchdb": "^9.0.0"
  },
  "dependencies": {
    "@public/shared": "workspace:*",
    "@public/utils": "workspace:^",
    "better-sqlite3": "^11.8.1",
    "uiohook-napi": "^1.5.4"
  }
}
