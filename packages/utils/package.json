{
  "name": "@public/utils",
  "version": "0.0.2",
  "description": "Get the Finder icon for a file path",
  "main": "index.ts",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./utils": "./utils.ts",
    "./render": "./src/render.ts",
    "./native": "./native.ts"
  },
  "scripts": {
    "build:node": "node-gyp rebuild",
    "build:node:debug": "node-gyp configure --debug -- -f compile_commands_json && mv ./build/Debug/compile_commands.json ./compile_commands.json && node-gyp rebuild --debug"
  },
  "keywords": [
    "Finder",
    "Preview",
    "MacOS",
    "OSX",
    "Mac",
    "Icon",
    "NSImage",
    "Electron",
    "QuickLook",
    "File"
  ],
  "author": "Ben Graney Green",
  "license": "MIT",
  "os": "darwin",
  "repository": "https://github.com/bengsquared/osx-fileicon",
  "dependencies": {
    "color": "^5.0.0",
    "nan": "^2.22.2",
    "node-addon-api": "^8.4.0",
    "run-applescript": "^7.0.0"
  },
  "devDependencies": {
    "node-gyp": "^11.2.0"
  }
}
